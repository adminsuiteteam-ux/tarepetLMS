# ==============================================================================
# Tarepet Montessori Backend Environment Configuration
# ==============================================================================

# Django Core
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,tarepetmontessorischool.com,.onrender.com

# 1. Database (Layerbase / Neon / Supabase PostgreSQL)
# Format: postgresql://username:password@hostname:port/database_name
DATABASE_URL=sqlite:///db.sqlite3

# 2. Redis Caching & Celery (Layerbase / Upstash / Render Redis)
# Format: redis://default:password@host:port/0 or rediss://...
REDIS_URL=

# 3. Cloudinary Media Storage (https://cloudinary.com -> Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 4. Sentry Backend Telemetry (https://sentry.io -> Django Project Settings -> Client Keys / DSN)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1
ENVIRONMENT=development
